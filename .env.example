# Copia questo file in .env e riempi i valori.
#
#   cp .env.example .env
#
# Il .env vero è in .gitignore e non deve mai comparire in `git status`.
# Qui dentro ci sono solo nomi e valori di esempio: se aggiungi una variabile
# al progetto, aggiungila anche qui, altrimenti chi clona non sa che esiste.

# --- PostgreSQL ---------------------------------------------------------------
# Usate sia dal contenitore (docker-compose.yml) sia dal codice Python e da dbt.
POSTGRES_USER=bi_pipeline
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=bi_pipeline

# Host visto dal codice che gira sulla macchina, non dentro Docker.
POSTGRES_HOST=localhost

# Porta esposta sulla macchina. Si cambia se la 5432 è già occupata da un altro
# PostgreSQL: dentro il contenitore resta comunque la 5432.
POSTGRES_PORT=5432

# --- Metabase (M7) --------------------------------------------------------
# Il database di appoggio di Metabase: dashboard, domande, utenti. Vive sullo
# stesso PostgreSQL ma separato dai dati delle vendite.
METABASE_DB_NAME=metabase
METABASE_PORT=3000

# L'utente con cui Metabase legge lo schema marts. Ha SELECT e nient'altro:
# non e' l'amministratore, e non deve poter scrivere.
METABASE_DB_USER=metabase_lettura
METABASE_DB_PASSWORD=cambiami

# L'amministratore dell'istanza Metabase, creato al primo avvio.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=cambiami-almeno-otto-caratteri
